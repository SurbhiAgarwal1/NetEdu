# ── NetEdu Environment Variables ──────────────────────────────────────────────
# Copy this to .env and fill in real values. NEVER commit .env to git.

# Django
SECRET_KEY=django-insecure-change-this-in-production-use-50-random-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL
POSTGRES_DB=netedu
POSTGRES_USER=netedu_user
POSTGRES_PASSWORD=netedu_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS — React dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT tokens (seconds)
ACCESS_TOKEN_LIFETIME=3600
REFRESH_TOKEN_LIFETIME=86400

# API throttling
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=300/min
THROTTLE_AUTH_LOGIN_RATE=10/min
THROTTLE_AUTH_REGISTER_RATE=5/min
